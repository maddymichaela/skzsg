---
import '../styles/timeline.css';
import storkImage from '../assets/stork.png';
import brushDotImage from '../assets/brush_dot.png';

const timelineItems = [
{
side: 'right',
dateLabel: '1 March',
timeLabel: '3.25PM',
title: 'test title',
detail: 'test description',
endDate: '2026-03-01T15:25:00+08:00',
},
{
side: 'left',
dateLabel: '29 August - 12 September',
timeLabel: '3.25PM',
title: 'Banner Phrase Submission',
endDate: '2026-09-12T15:25:00+08:00',
},
{
side: 'right',
dateLabel: '26 September - 10 October',
timeLabel: '3.25PM',
title: 'Banner Phrase Poll',
detail: 'Vote for your favourite phrase that will go on the banner',
endDate: '2026-10-10T15:25:00+08:00',
},
{
side: 'left',
dateLabel: '17 October',
timeLabel: '3.25PM',
title: 'Banner Phrase Reveal',
endDate: '2026-10-17T15:25:00+08:00',
},
{
side: 'right',
dateLabel: '24 October - 7 November',
timeLabel: '3.25PM',
title: 'Banner Design & Video Poll',
endDate: '2026-11-07T15:25:00+08:00',
},
{
side: 'left',
dateLabel: '14 November',
timeLabel: '3.25PM',
title: 'Banner Design Reveal',
endDate: '2026-11-14T15:25:00+08:00',
},
{
side: 'right',
title: 'More Coming Soon'
},
];

const hiddenTimelineItems = [
{
dateLabel: '21 November',
title: 'Donation Goods Reveal',
timeLabel: '3.25PM',
endDate: '2026-11-21T15:25:00+08:00',
},
{
dateLabel: '5 December',
title: 'Donation Goods Mockup Post',
timeLabel: '3.25PM',
endDate: '2026-12-05T15:25:00+08:00',
},
];

void hiddenTimelineItems;
---

<section id="timeline" class="timeline-section" aria-labelledby="timeline-title" style={`--timeline-marker-image:
    url("${brushDotImage.src}")`}>
    <div class="timeline-hero">
        <h2 id="timeline-title">Timeline</h2>
    </div>

    <div class="timeline-board" aria-label="Concert day timeline">
        <img class="timeline-stork" src={storkImage.src} alt="" aria-hidden="true" />

        <ol class="timeline-list">
            {timelineItems.map((item) => (
            <li class:list={['timeline-item', `is-${item.side}`]} data-end-date={item.endDate}>
                <div class="timeline-marker" aria-hidden="true"></div>
                <article class="timeline-copy">
                    {(item.dateLabel || item.timeLabel) && (
                    <p class="timeline-time">
                        {item.dateLabel}
                        {item.timeLabel && <span>{item.timeLabel}</span>}
                    </p>
                    )}
                    <h3>{item.title}</h3>
                    <p>{item.detail}</p>
                </article>
            </li>
            ))}
        </ol>
    </div>
</section>

<script>
    const timelineItems = document.querySelectorAll('[data-end-date]');
    const now = new Date();

    timelineItems.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;

        const endDate = new Date(item.dataset.endDate ?? '');

        if (!Number.isNaN(endDate.getTime()) && endDate.getTime() < now.getTime()) {
            item.classList.add('is-past');
        }
    });
</script>