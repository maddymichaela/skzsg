---
import strokeImage from '../assets/stroke.png';
import '../styles/goals.css';
import { getEntry } from 'astro:content';

const goalsEntry = await getEntry('goals', 'goals');

if (!goalsEntry) {
	throw new Error('Goals settings not found. Add src/content/settings/goals.json');
}

const { generalGoals, stretchGoals } = goalsEntry.data;
---

<section id="goals" class="goals-section" style={`--goals-stroke-image: url("${strokeImage.src}")`}>
    <div class="hero goals-hero">
        <h2 class="mix-title" id="goals-title">
            <span class="title-ko">목표</span>
            <span class="title-en">Goals</span>
        </h2>

        <div class="goals-board">
            <div class="goals-column" id="general-goals" data-step="01">
                <div class="goals-copy">
                    <h3>General</h3>
                    <ul class="list">
                        {generalGoals.map((goal) => (
                            <li>{goal}</li>
                        ))}
                    </ul>
                </div>
            </div>
            <div class="goals-column" id="stretch-goals" data-step="02">
                <div class="goals-copy">
                    <h3>Stretch</h3>
                    <ul class="list">
                        {stretchGoals.map((goal) => (
                            <li>{goal}</li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>