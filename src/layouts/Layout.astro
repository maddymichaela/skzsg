---
import '../styles/layout.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import background from '../assets/background2.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&display=swap" rel="stylesheet">

		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Stray Kids Singapore Run It</title>
	</head>
	<body>
		<img class="site-bg" src={background.src} alt="" aria-hidden="true" />
		<Nav />
		<slot />
		<Footer />
		<script>
			const revealSections = Array.from(document.querySelectorAll('section:not(.countdown-shell)'));
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!prefersReducedMotion && revealSections.length > 0) {
				document.body.classList.add('is-scroll-reveal-ready');

				const revealObserver = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;

						entry.target.classList.add('is-section-visible');
						revealObserver.unobserve(entry.target);
					});
				}, {
					rootMargin: '0px 0px -18% 0px',
					threshold: 0.16,
				});

				revealSections.forEach((section) => {
					if (!(section instanceof HTMLElement)) return;

					revealObserver.observe(section);
				});
			}
		</script>
	</body>
</html>
